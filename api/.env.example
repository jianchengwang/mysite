# Fill these on the deployment host; never commit actual values.
LISTEN_ADDR=127.0.0.1:8000
BACKEND_ACCESS_KEY=
# Existing MySQL 8.0+ database and dedicated least-privilege user.
# Percent-encoding is not a substitute for Go mysql DSN syntax.
MYSQL_DSN=mysite:REPLACE_ON_HOST@tcp(mysql:3306)/mysite?charset=utf8mb4&collation=utf8mb4_unicode_ci
CORS_ORIGINS=https://your-domain.example
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Server only. Empty disables TTS with HTTP 503; never pass this key to workflows.
MIMO_API_KEY=
