              "published": true
            },
            {
              "slug": "4-k8s/k8s-network",
              "title": "从域名到 Pod 的一次请求",
              "description": "沿着读书笔记 API 的请求路径，理解 Service、EndpointSlice、DNS、入口路由与就绪状态，并用分层证据定位网络故障。",
              "order": 5,
              "published": true
            },
            {
              "slug": "4-k8s/k8s-configuration",
              "title": "配置与数据为什么需要独立生命周期",
              "description": "从配置更新、图片持久化和数据库升级出发，理解 ConfigMap、Secret、PV、PVC 与 StatefulSet 的责任边界。",
              "order": 6,
              "published": true
            }
          ]
        },
        {
          "id": "delivery",
